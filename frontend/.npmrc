# @copilotkit/runtime declares a broad set of *optional* LLM-provider peer deps
# (openai, langchain, groq-sdk, …). We drive the runtime with ExperimentalEmptyAdapter
# because the LLM lives in the Django Pydantic-AI agent, so none of those SDKs are used.
# One of them (openai@4) pins zod@^3 while this app is on zod@4 — an irreconcilable
# peer conflict on a dependency we never load. legacy-peer-deps lets npm install / npm ci
# resolve the tree instead of hard-failing on that phantom conflict.
legacy-peer-deps=true
